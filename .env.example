# A copied JupyterLab URL is accepted; Jupydex removes /lab/... automatically.
# Do not append ?token=... here in a committed file.
JUPYDEX_URL=https://jupyter.example/user/your-name

# Export the real value from a private shell profile or secret manager.
JUPYDEX_TOKEN=replace-at-runtime

# Jupydex refuses to guess among existing terminals.
JUPYDEX_TERMINAL=agent_shell

# Optional project default.
JUPYDEX_CWD=/workspace/project

# Keep enabled unless the server uses a private CA.
JUPYDEX_VERIFY_TLS=true
